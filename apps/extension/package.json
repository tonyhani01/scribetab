{
  "name": "@scribetab/extension",
  "version": "1.2.1",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "typecheck": "wxt prepare && tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "test": "wxt prepare && vitest run",
    "e2e": "wxt build && playwright test",
    "zip": "wxt zip",
    "pretest": "pnpm --filter @scribetab/shared build",
    "pretypecheck": "pnpm --filter @scribetab/shared build",
    "prebuild": "pnpm --filter @scribetab/shared build",
    "pree2e": "pnpm --filter @scribetab/shared build",
    "prezip": "pnpm --filter @scribetab/shared build"
  },
  "dependencies": {
    "@scribetab/shared": "workspace:*",
    "minisearch": "^7.2.0",
    "preact": "^10.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/chrome": "^0.0.280",
    "@types/node": "^22.10.0",
    "fake-indexeddb": "^6.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wxt": "^0.19.0"
  }
}
